{
  "name": "@yuxu-palace/yxp-lib-start",
  "version": "0.0.0",
  "description": "Quickstart template for building yuxu-palace libraries.",
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch",
    "dev:mf": "rslib mf-dev",
    "check": "biome check --write --no-errors-on-unmatched",
    "format": "biome format --write --no-errors-on-unmatched",
    "test": "vitest",
    "test:ci": "cross-env CI=true vitest run",
    "prepare": "husky"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    }
  },
  "main": "./dist/cjs/index.cjs",
  "types": "./dist/esm/index.d.ts",
  "keywords": [],
  "author": "yuxu-palace",
  "license": "MIT",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=18.0.0"
    },
    "packageManager": {
      "name": "pnpm"
    }
  },
  "devDependencies": {
    "@codspeed/vitest-plugin": "^5.0.1",
    "@biomejs/biome": "^2.2.5",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@rslib/core": "^0.15.0",
    "@types/node": "^24.3.1",
    "cross-env": "^10.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "typescript": "^5.9.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
}
